{
	"name": "inline-local-graph",
	"version": "0.9.11",
	"description": "Visualize the local graph inline within your notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"setup-vault": "node scripts/setup-test-vault.mjs",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"graph",
		"local graph",
		"inline graph",
		"inline local graph",
		"plugin"
	],
	"author": "TKOxff <tkoxff@gmail.com>",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@eslint/json": "0.14.0",
		"@types/node": "^16.11.6",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.70.1"
	},
	"dependencies": {
		"vis-network": "^10.0.1"
	}
}
